# Database (SQLite local; Postgres in Docker/Render)
DATABASE_URL=sqlite:///./regulatory_intel.db

# Email (Gmail App Password) — optional, for daily digest emails
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
DEFAULT_DIGEST_EMAIL=

# Server — 0.0.0.0 makes the site reachable on your network
API_HOST=0.0.0.0
PORT=8080
PUBLIC_URL=
CORS_ORIGINS=*

# Ingestion
INGEST_LOOKBACK_DAYS=30
RUN_INITIAL_INGEST=true
USER_AGENT=RegulatoryIntelBot/1.0 (+https://regulatory-intelligence)

# Scheduler (UTC)
INGEST_CRON_HOUR=6
DIGEST_CRON_HOUR=7
